#!/usr/bin/env bash
# Wraps real mktemp; set REASON to force a failure (tests only):
#   temp-file    — every plain mktemp call fails
#   temp-dir     — mktemp -d call fails
MKTEMP="$(command -v mktemp)"
[[ -n "${MKTEMP}" ]] || { echo "stub mktemp: mktemp not on PATH" >&2; exit 99; }

case "${REASON:-}" in
  temp-file)
    if [[ ${1:-} == "-p" || ${1:-} == "" ]]; then
      echo "mktemp: simulated failure creating temp file" >&2
      exit 1
    fi
    ;;
  temp-dir)
    if [[ ${1:-} == "-d" ]]; then
      echo "mktemp: simulated failure creating temp directory" >&2
      exit 1
    fi
    ;;
  *)
    echo "stub mktemp: set REASON to temp-file or temp-dir" >&2
    exit 99
    ;;
esac
exec "${MKTEMP}" "$@"
